---
import { storyblokEditable } from "@storyblok/astro";
import type { Content } from "@types/PartidoTypes";
import { Image } from "astro:assets";
import parseDate from "src/utils/parseDate";

export interface Props {
  blok: Content;
}

const { blok } = Astro.props;

const {
  logo_local,
  nombre_local,
  logo_visitante,
  nombre_visitante,
  academia,
  lugar,
  fecha,
  enlace_partido,
} = blok;
---

<div
  class="flex flex-col items-center text-center bg-cover bg-center p-4 rounded-lg shadow-lg text-white"
  {...storyblokEditable(blok)}
>
  <div class="flex items-center justify-around w-full mb-4">
    <!-- Equipo 1 -->
    <div class="flex flex-col items-center">
      <Image
        src={logo_local.filename}
        alt={nombre_local}
        inferSize
        class="size-4"
      />
      <p class="text-xl font-semibold">{nombre_local}</p>
    </div>

    <p class="text-2xl font-bold mx-4">v.</p>

    <!-- Equipo 2 -->
    <div class="flex flex-col items-center">
      <Image
        src={logo_visitante.filename}
        alt={nombre_visitante}
        inferSize
        class="size-4"
      />
      <p class="text-xl font-semibold">{nombre_visitante}</p>
    </div>
  </div>

  <p class="text-lg mb-2">Academia: {academia}</p>

  <!-- Lugar -->
  <p class="text-lg mb-2">Lugar: {lugar}</p>

  <!-- Fecha -->
  <p class="text-lg mb-4">Fecha: {parseDate(fecha)}</p>

  <!-- Botón de Enlace -->
  <a
    href={enlace_partido?.url}
    class="inline-block bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-full"
  >
    En vivo aquí
  </a>
</div>
