---
import { storyblokEditable } from "@storyblok/astro";
import { renderRichText } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import { Image } from "astro:assets";
import type { Content } from "@types/NoticiaTypes";
import { useStoryblokApi } from "@storyblok/astro";
import Compartir from "@components/Compartir.astro";

export interface Props {
  blok: Content;
}

const { blok } = Astro.props;
const storyblokApi = useStoryblokApi();

const { data } = await storyblokApi.get(`cdn/stories/`, {
  starts_with: "autores/",
  per_page: 1,
  version: import.meta.env.DEV ? "draft" : "published",
  by_uuids: blok.autor,
});

const autor = data.stories[0].content;

const { titulo, cuerpo, fecha, portada } = blok;

const html_cuerpo = renderRichText(cuerpo);
---

<div class="max-w-4xl mx-auto p-8" {...storyblokEditable(blok)}>
  <h1 class="text-center">{titulo}</h1>
  <Image
    src={portada.filename}
    alt={titulo}
    inferSize
    class="max-w-md max-md:max-w-40 object-cover m-6"
  />
  <div>
    <StoryblokComponent blok={autor} />
  </div>
  <p class="text-gray-500 mb-4 text-left">
    Publicado el {
      new Date(fecha).toLocaleDateString("es-MX", {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
      })
    }
  </p>
  <div class="prose" set:html={html_cuerpo} />
  <br />
  <Compartir title={titulo} />
</div>
