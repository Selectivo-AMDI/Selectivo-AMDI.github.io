---
import type { Story } from "@types/NoticiasStoryTypes";
import { Image } from "astro:assets";

const { blok } = Astro.props;

---

<section class="max-w-4xl mx-auto p-8" id="noticias">
  <h1 class="text-4xl font-bold text-center">Noticias</h1>
  <h2>Todo lo nuevo que AMDI tiene para ti</h2>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 p-4">
    {
      blok.map((noticia: Story) => (
        <div class="bg-white shadow-md rounded-lg">
          <a href={`/noticias/${noticia.slug}`}>
            <Image
              src={noticia.content.body[0].Imagen_portada.filename}
              inferSize
              alt={noticia.content.body[0].Titulo || "Noticia"}
              class="w-full h-48 object-cover"
            />
            <div class="p-4">
              <h2 class="text-xl font-semibold text-gray-800">
                {noticia.content.body[0].Titulo}
              </h2>
              <p class="text-gray-500">
                {new Date(
                  noticia.content.body[0].Fecha_publicacion,
                ).toLocaleDateString("es-MX")}
              </p>
            </div>
          </a>
        </div>
      ))
    }
  </div>
  <a href="/noticias">
    <p class="text-xl p-3 bg-red-700 hover:bg-red-800 rounded-xl">Ver más</p>
  </a>
</section>
