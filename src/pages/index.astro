---
import { Image } from "astro:assets";

import equipo2 from "@images/equipo2.webp";
import equipo from "@images/equipo.webp";
import equipo3 from "@images/equipo3.webp";

import Layout from "@layout";
import BtnDonar from "@components/BtnDonar.astro";
import Noticias from "@components/Noticias.astro";
import Historia from "@components/Historia.astro";
import MisionVision from "@components/MisionVision.astro";
import Partidos from "@components/Partidos.astro";
import CoverCarrousel from "@components/CoverCarrousel.astro";
---

<Layout title="Selección AMDI Jalisco | Página oficial" description="Página oficial de AMDI Jalisco">
  <main class="text-center">

    {/*
       <div
      id="presentacion"
      class="relative bg-cover bg-[url('/donacion.jpg')] bg-center h-screen grid items-center"
    >
      <div class="absolute inset-0 bg-black opacity-70"></div>
      <div class="relative z-10 p-8 text-left">
        <h1 class="lg:text-6xl font-bold">Necesitamos tu ayuda</h1>
        <p class="p-4 lg:text-xl text-sm">
          Somos una asociación que busca el desarrollo de niños y niñas a través del deporte.
        </p>
        <BtnDonar />
      </div>
    </div>
    */}
    <CoverCarrousel />
    <div id="noticias">
      <h1 class="text-4xl font-bold">Lo más nuevo en AMDI</h2>
      <p>Mantente al tanto de lo que nuestra asociación está aportando a la sociedad</p>
      <!--<Noticias />-->
    </div>
    <div id="partidos">
      <h2 class="text-4xl font-bold">Partidos en nuestras academias:</h2>
      <p>No te pierdas de los nuevos partidos que nuestras academias están a punto de ganar</p>
      <!--<Partidos />-->

    </div>
    <div id="quienes" class="p-4 mb-4 font-medium bg-[url('../bg.svg')] bg-blend-darken bg-bottom bg-no-repeat bg-cover bg-black/70">

      <h2 class="text-4xl md:text-6xl sm:text-6xl p-4">#DejandoHuella</h2>
      <p class="text-balance text-lg">
        Somos la Asociación Mexicana de Desarrollo Motriz Infantil. participante
        de la Copa America AIFI. de diversas categorias infantiles, como 2012 o
        2008.
      </p>

      <div class="h-full py-6 sm:py-8 lg:py-12">
        <div class="mx-auto max-w-screen-2xl px-4 md:px-8">
          <div
            class="mb-4 flex items-center justify-between gap-8 sm:mb-8 md:mb-12"
          >
          </div>

          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
            <!-- image - start -->
            <a
              class="group relative flex h-48 items-end overflow-hidden rounded-lg bg-gray-100 shadow-lg md:h-80"
            >
              <Image
                src={equipo}
                loading="lazy"
                alt="Entrenador enseñando al equipo de niños"
                class="absolute inset-0 h-full w-full object-cover object-center transition duration-200 group-hover:scale-110"
              />

              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-800 via-transparent to-transparent opacity-50"
              >
              </div>

              <span
                class="relative ml-4 mb-3 inline-block text-sm  md:ml-5 md:text-lg"
                >Esfuerzo</span
              >
            </a>
            <!-- image - end -->
            <!-- image - start -->
            <a
              class="group relative flex h-48 items-end overflow-hidden rounded-lg bg-gray-100 shadow-lg md:col-span-2 md:h-80"
            >
              <Image
                src={equipo2}
                loading="lazy"
                alt="Equipo formulando un plan"
                class="absolute inset-0 h-full w-full object-cover object-center transition duration-200 group-hover:scale-110"
              />

              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-800 via-transparent to-transparent opacity-50"
              >
              </div>

              <span
                class="relative ml-4 mb-3 inline-block text-sm  md:ml-5 md:text-lg"
                >Aprendizaje</span
              >
            </a>
            <!-- image - end -->
            <!-- image - start -->
            <a
              class="group relative flex h-48 items-end overflow-hidden rounded-lg bg-gray-100 shadow-lg md:col-span-2 md:h-80"
            >
              <Image
                src={equipo}
                loading="lazy"
                alt="Equipo tomandose una foto en un templo"
                class="absolute inset-0 h-full w-full object-cover object-center transition duration-200 group-hover:scale-110"
              />

              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-800 via-transparent to-transparent opacity-50"
              >
              </div>

              <span
                class="relative ml-4 mb-3 inline-block text-sm  md:ml-5 md:text-lg"
                >Hermandad</span
              >
            </a>
            <!-- image - end -->
            <!-- image - start -->
            <a
              class="group relative ¿Qué academia te gustaría que AMDI tuviera?flex h-48 items-end overflow-hidden rounded-lg bg-gray-100 shadow-lg md:h-80"
            >
              <Image
                src={equipo3}
                loading="lazy"
                alt="Jugadores compitiendo por el balón"
                class="absolute inset-0 h-full w-full object-cover object-center transition duration-200 group-hover:scale-110"
              />

              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-800 via-transparent to-transparent opacity-50"
              >
              </div>

              <span
                class="relative ml-4 mb-3 inline-block text-sm  md:ml-5 md:text-lg"
                >Ganar</span
              >
            </a>
            <!-- image - end -->
          </div>
        </div>
      </div>
    </div>
    <Historia />
    <MisionVision />
  </main>
</Layout>