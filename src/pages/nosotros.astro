---
import type { Data } from "@types/TrabajadorTypes";
import { Image } from "astro:assets";
import { useStoryblokApi } from "@storyblok/astro";
import Layout from "@layout";
import Copa_Brasil from "@images/copa_brasil.webp";
import Equipo9 from "@images/equipo9.webp";
import Equipo10 from "@images/equipo10.webp";
import Disciplina from "@icons/disciplina.png";
import Respeto from "@icons/respeto.png";
import Companerismo from "@icons/compañerismo.png";
import Equipo from "@icons/equipo.png";
import Esfuerzo from "@icons/esfuerzo.png";
import Excelencia from "@icons/excelencia.png";

const storyblokApi = useStoryblokApi();
const { data } = (await storyblokApi.get("cdn/stories/", {
  version: import.meta.env.DEV ? "draft" : "published",
  starts_with: "trabajadores/",
})) as { data: Data };

const trabajadores = data.stories;
---

<Layout
  title="Nosotros"
  description="Conoce la misión, visión y valores de AMDI"
>
  <section class="max-w-4xl mx-auto p-8">
    <h1 class="text-center">Nosotros</h1>

    <!-- Misión -->
    <div class="mb-12">
      <h2>Nuestra Misión</h2>
      <Image
        src={Equipo9}
        alt="AMDI en la copa Brasil"
        class="w-full h-64 object-cover rounded-lg mb-6"
      />

      <p class="text-lg leading-relaxed">
        AMDI fue fundada con la misión de llevar a los niños a alcanzar todo su
        potencial y transformarlos en jugadores competitivos capaces de destacar
        en las mejores ligas del país. Selección AMDI Jalisco se dedica a
        proporcionar una plataforma donde el talento y la pasión de los jóvenes
        jaliscienses puedan brillar, a través de un enfoque integral que abarca
        el desarrollo físico, emocional y mental.
      </p>
    </div>

    <!-- Visión -->
    <div class="mb-12">
      <h2>Nuestra Visión</h2>
      <Image
        src={Copa_Brasil}
        alt="AMDI entrenando a las nuevas generaciones"
        class="w-full h-64 object-cover rounded-lg mb-6"
      />

      <p class="text-lg leading-relaxed">
        La visión de AMDI es crear una comunidad de apoyo que fomente el
        compañerismo y la disciplina, preparando a los jóvenes no solo para el
        deporte, sino también para la vida. AMDI aspira a ser reconocida como un
        semillero de campeones que no solo logran victorias en el campo, sino
        que también llevan consigo valores sólidos y un profundo amor por el
        juego, impactando positivamente la vida de sus miembros y sus
        comunidades.
      </p>
    </div>

    <div class="mb-12" id="valores">
      <h2>Nuestros Valores</h2>

      <Image
        src={Equipo10}
        alt="Imagen representando los valores de AMDI"
        class="w-full h-64 object-cover rounded-lg mb-6"
      />

      <p class="text-lg leading-relaxed pb-4">
        Esto es lo que enseñamos y defendemos en cada partido en el que vamos:
      </p>

      <ul
        class="sm:text-lg *:justify-items-center *:grid *:items-center grid-cols-1 grid md:grid-cols-2 justify-center items-center *:font-bold list-none text-center"
      >
        <li class="bg-green-500">
          Compañerismo
          <Image src={Companerismo} alt="icono de compañerismo" />
        </li>
        <li class="bg-red-500">
          Disciplina
          <Image src={Disciplina} alt="icono de disciplina" />
        </li>
        <li class="bg-blue-500">
          Respeto
          <Image src={Respeto} alt="icono de respeto" />
        </li>
        <li class="bg-yellow-500">
          Trabajo en equipo
          <Image src={Equipo} alt="icono de trabajo en equipo" />
        </li>
        <li class="bg-amber-500">
          Esfuerzo continuo
          <Image src={Esfuerzo} alt="icono de esfuerzo" />
        </li>
        <li class="bg-rose-500">
          Compromiso con la excelencia
          <Image src={Excelencia} alt="icono de excelencia" />
        </li>
      </ul>
    </div>

    <div id="quienes" class="items-center justify-center">
      <h2>¿Quiénes somos?</h2>
      <p class="pb-4">
        Nuestro gran equipo en la asociación está compuesto por:
      </p>
      <div
        class="presentacion *:grid *:lg:grid-cols-2 grid md:grid-cols-2 grid-cols-1 justify-center items-center text-center"
      >
        {
          trabajadores.map(({ content: { nombre, imagen, rol } }) => (
            <div
              id={nombre}
              class="p-4 flex flex-col items-center content-center justify-center"
            >
              <Image
                src={imagen.filename}
                inferSize
                alt={imagen.alt ?? `foto del ${rol}, ${nombre}`}
                class="rounded-full object-cover w-48 h-48"
              />
              <div id={`datos_${nombre}`} class="mt-4">
                <h3>{nombre}</h3>
                <p>{rol}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
