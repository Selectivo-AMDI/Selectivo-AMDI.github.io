---
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import type { Data } from "@types/NoticiaTypes";
import { useStoryblokApi } from "@storyblok/astro";
import Layout from "@layout";

const { slug } = Astro.params;
const storyblokApi = useStoryblokApi();
let noticia;

try {
  const { data } = (await storyblokApi.get(`cdn/stories/noticias/${slug}`, {
    version: import.meta.env.DEV ? "draft" : "published",
  })) as { data: Data };

  noticia = data.story.content;
} catch (error) {
  return Astro.redirect("/404");
}
---

<Layout title={noticia.titulo} description={noticia.titulo}>
  <StoryblokComponent blok={noticia} />
</Layout>
