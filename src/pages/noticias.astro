---
import { useStoryblokApi } from "@storyblok/astro";
import type { Data } from "@types/NoticiaTypes";
import Layout from "@layout";
import NoticiaCard from "@components/NoticiaCard.astro";

const storyblokApi = useStoryblokApi();

const { data } = (await storyblokApi.get("cdn/stories", {
  starts_with: "noticias/",
  version: import.meta.env.DEV ? "draft" : "published",
})) as { data: Data };

const noticias = data.stories;
---

<Layout title="Noticias" description="Listado de todas las noticias de AMDI">
  <section class="max-w-4xl mx-auto p-8">
    <h1 class="text-center">Noticias</h1>
    <h2>
      Noticias oficiales acerca de todo lo que pasa en AMDI: Alianzas,
      acontecimientos importantes, premios, campeonatos estatales. Todo en un
      sólo lugar
    </h2>

    <!-- Grid para mostrar todas las noticias -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {noticias.map((noticia) => <NoticiaCard story={noticia} />)}
    </div>
  </section>
</Layout>
