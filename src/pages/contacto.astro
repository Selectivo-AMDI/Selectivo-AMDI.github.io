---
// Contacto.astro
import { Image } from "astro:assets";
import icono from "@images/logo.webp";
import Layout from "@layout";

import { TELEFONO } from "src/constants";

// Información de contacto
const contacto = {
  telefono: "+52 33 1234 5678",
  direccion: "Av. Patria 123, Colonia Deportiva, Guadalajara, Jalisco, México",
  correo: "contacto@amdi.org.mx",
  redes: [
    { nombre: "Facebook", url: "https://facebook.com/AMDI", icon: "fab fa-facebook" },
    { nombre: "Instagram", url: "https://instagram.com/AMDI", icon: "fab fa-instagram" },
    { nombre: "Twitter", url: "https://twitter.com/AMDI", icon: "fab fa-twitter" },
    { nombre: "WhatsApp", url: "https://wa.me/523312345678", icon: "fab fa-whatsapp" },
  ],
};
---

<Layout title="Contáctanos" description="Ponte en contacto con AMDI para más información">
  <main class="text-gray-800 py-12 px-4">
    <section class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl font-bold mb-4 text-red-700">¡Contáctanos!</h1>
      <p class="text-lg leading-relaxed">
        Estamos aquí para responder tus preguntas y brindarte toda la información que necesites
        acerca de nuestras actividades, programas y formas de colaborar con nosotros.
      </p>
    </section>

    <!-- Información de contacto -->
    <section class="max-w-3xl mx-auto bg-white mt-8 p-6 rounded-lg shadow-md">
      <h2 class="text-3xl font-bold text-gray-700 mb-6">Información de Contacto</h2>

      <!-- Teléfono -->
      <div class="flex items-center mb-4">
        <i class="fas fa-phone-alt text-red-700 mr-4"></i>
        <a href={`tel:${TELEFONO}`} class="text-lg text-blue-600 hover:underline">
          {contacto.telefono}
    </div>

      <!-- Dirección -->
      <div class="flex items-center mb-4">
        <i class="fas fa-map-marker-alt text-red-700 mr-4"></i>
        <p class="text-lg">{contacto.direccion}</p>
      </div>

      <!-- Correo Electrónico -->
      <div class="flex items-center mb-4">
        <i class="fas fa-envelope text-red-700 mr-4"></i>
        <a href={`mailto:${contacto.correo}`} class="text-lg text-blue-600 hover:underline">
          {contacto.correo}
        </a>
      </div>

      <!-- Redes Sociales -->
      <div>
        <h3 class="text-2xl font-bold text-gray-700 mb-4">Síguenos en nuestras redes sociales</h3>
        <ul class="flex justify-center space-x-6">
          {contacto.redes.map((red) => (
            <li>
              <a
                href={red.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-red-700 hover:text-red-800 text-3xl"
              >
                <i class={red.icon}></i>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</Layout>
