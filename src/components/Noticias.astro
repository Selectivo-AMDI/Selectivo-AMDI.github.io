---
import { useStoryblokApi } from "@storyblok/astro";
import type { Noticias } from "@types/NoticiasStoriesTypes.ts";
import Noticia from "@components/Noticia.astro";

const storyblokApi = useStoryblokApi();

const { data } = (await storyblokApi.get("cdn/stories", {
    starts_with: "noticias/",
    version: import.meta.env.DEV ? "draft" : "published",
    per_page: 4,
})) as { data: Noticias };

const noticias = data.stories;

---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 justify-items-center">
    {
        noticias.map(({ slug, content: {Imagen_portada, Titulo, Fecha_publicacion} }) => (
            <Noticia
                imagen_portada={Imagen_portada.filename}
                titulo={Titulo}
                slug={slug}
                fecha_publicacion={Fecha_publicacion}
            />
        ))
    }
</div>
