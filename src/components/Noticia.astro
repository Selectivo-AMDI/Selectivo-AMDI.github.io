---
import { Image } from "astro:assets";
import parseDate from "../utils/parseDate.ts";

export interface Props {
    imagen_portada: string;
    titulo: string;
    slug: string;
    fecha_publicacion: string;
}

const { imagen_portada, titulo, slug, fecha_publicacion } = Astro.props;
---

<article
    class="w-64 m-4 h-96 hover:scale-105 bg-amdi-white hover:bg-amdi-black transition text-gray-800 hover:text-amdi-white duration-300 shadow-md rounded-lg overflow-hidden"
>
    <a href={`/noticias/${slug}`}>
        {/* Imagen que ocupa la mitad superior */}
        <div class="h-1/2 w-full">
            <Image
                src={imagen_portada}
                inferSize
                alt={titulo}
                class="w-full h-full object-cover"
            />
        </div>
        {/* Texto que ocupa la mitad inferior */}
        <div
            class="h-1/2 flex flex-col items-center justify-center text-center p-3"
        >
            <h2 class="text-lg font-bold mb-2">
                {titulo}
            </h2>
            <p class="text-sm">
                {parseDate(new Date(fecha_publicacion))}
            </p>
        </div>
    </a>
</article>
