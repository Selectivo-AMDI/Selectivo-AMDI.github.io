---
import { Image } from "astro:assets";
import { historias } from "@data/historia.json";
import NotaCompleta from "@components/NotaCompleta.astro";

const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/*.webp",
);
---

<div id="historia" class="justify-center items-center bg-[url('../historia-bg.jpg')] bg-blend-darken bg-black/75 bg-repeat bg-cover">
    <h2 class="text-4xl font-medium">Historia:</h2>
    <hr
      class="w-64 h-1 mx-auto my-4 bg-gray-100 border-0 rounded md:my-10 dark:bg-gray-700"
    />

    {
      historias.map(( { descripcion, fecha, alt, imagen, nota }, index ) => (
      <h3 class="text-2xl font-medium">{fecha}</h3>
      <p class="text-4xl font-medium">↓</p>

      <div id="inicios" class="p-4 xl:flex items-center justify-center">
        {index % 2 === 0
          ? (
            <p>
              {descripcion}
              <NotaCompleta nota={nota} />
            </p>
            <div class="xl:flex-shrink-0">
              <Image
                src={imagenes[`/src/images/${imagen}`]() }
                loading="lazy"
                alt={alt ?? "Imagen"}
                class="p-4 m-auto."
                height="500"
                width="500"
              />
            </div>
        ) : (
            <div class="xl:flex-shrink-0">
              <Image
                src={imagenes[`/src/images/${imagen}`]() }
                loading="lazy"
                alt={alt ?? "Imagen"}
                class="p-4 m-auto"
                height="500"
                width="500"
              />
            </div>
              <p>
                {descripcion}
                <NotaCompleta nota={nota} />
              </p>
        )}
    </div>  
      ))
    }
  </div>