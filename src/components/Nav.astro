---
import { opciones } from "@data/navbar.json";
import icono from "@images/logo.webp";
import { Image } from "astro:assets";
import Social from "./Social.astro";

const menu = (mobile: boolean) =>
	opciones.map(
		({ url, nombre }) =>
			`<li class*="mb-1"><a class="text-sm text-white clickeable lg:p-3 p-1 rounded ${mobile ? "block font-semibold" : ""}" href="${url}">${nombre}</a></li>`,
	);
---

<nav
	class="fixed top-0 left-0 w-full p-4 z-50 px-3 py-3 flex justify-between items-center bg-[url('/src/nav-bg.svg')] bg-no-repeat bg-cover bg-blend-darken bg-bottom bg-black/50"
>
	<a
		class="text-3xl font-bold leading-none md:justify-center md:content-center"
		href="/"
	>
		<Image
			src={icono}
			alt="Icono de AMDI"
			class="rounded-full"
			height={icono.height / 20}
			width={icono.width / 20}
		/>
	</a>
	<div class="lg:hidden">
		<button class="navbar-burger flex items-center text-white p-3">
			<svg
				class="block h-4 w-4 fill-current"
				viewBox="0 0 20 20"
				xmlns="http://www.w3.org/2000/svg"
			>
				<title>Mobile menu</title>
				<path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"></path>
			</svg>
		</button>
	</div>
	<ul
		class="hidden absolute top-1/2 left-1/2 transform -translate-y-1/2 -translate-x-1/2 lg:flex lg:mx-auto lg:items-center lg:w-auto lg:space-x-6"
	>
		<Fragment set:html={menu(true)} />
	</ul>
	<div class="max-lg:hidden">
		<Social />
	</div>
</nav>
<div class="navbar-menu relative z-50 hidden">
	<div class="navbar-backdrop fixed inset-0 bg-red-800 opacity-25"></div>
	<nav
		class="fixed top-0 left-0 bottom-0 flex flex-col w-5/6 max-w-sm py-6 px-6 bg-[url('../nav-bg.svg')] bg-no-repeat bg-cover bg-left border-r overflow-y-auto"
	>
		<div class="flex items-center mb-8">
			<a class="mr-auto text-3xl font-bold leading-none center" href="/">
				<Image
					src={icono}
					alt="Icono de AMDI"
					class="rounded-full"
					height={icono.height / 20}
					width={icono.width / 20}
				/>
			</a>
			<button class="navbar-close">
				<svg
					class="h-6 w-6 text-gray-400 cursor-pointer hover:text-gray-500"
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
		<div>
			<ul>
				<Fragment set:html={menu(false)} />
			</ul>
			<p class="pt-6 text-sm">Nuestras redes sociales oficiales:</p>
			<Social />
		</div>
	</nav>
</div>
<script>
	document.addEventListener("DOMContentLoaded", function () {
		const burger = document.querySelector(".navbar-burger");
		const menu = document.querySelector(".navbar-menu");
		const close = document.querySelector(".navbar-close");
		const backdrop = document.querySelector(".navbar-backdrop");
		const menuLinks = document.querySelectorAll(".navbar-menu a");

		function toggleMenu() {
			menu?.classList.toggle("hidden");
		}

		// Cerrar el menú si está abierto
		function closeMenu() {
			if (!menu?.classList.contains("hidden")) {
				menu?.classList.add("hidden");
			}
		}

		// Abrir y cerrar menú con el botón de hamburguesa
		burger?.addEventListener("click", toggleMenu);

		// Cerrar el menú cuando se hace clic en el botón de cerrar o en el backdrop
		close?.addEventListener("click", closeMenu);
		backdrop?.addEventListener("click", closeMenu);

		// Cerrar el menú cuando se selecciona un enlace
		menuLinks.forEach((link) => {
			link.addEventListener("click", closeMenu);
		});
	});
</script>
